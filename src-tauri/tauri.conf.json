{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "title": "Mio Reader",
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Mio Reader - doc sach va truyen tranh tren PC",
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "nsis": {},
      "wix": {
        "language": "en-US"
      }
    }
  },
  "identifier": "vn.thien.doc-sach",
  "productName": "Mio Reader",
  "version": "0.3.1"
}
